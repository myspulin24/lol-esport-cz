{
  "name": "lol-esport-cz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Český automatický přehled LoL esportu (neoficiální fan projekt)",
  "scripts": {
    "data": "tsx pipeline/run.ts",
    "dev": "astro dev",
    "build": "astro build && node scripts/make-sw.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "tsx pipeline/deploy-cli.ts",
    "check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.8",
    "basic-ftp": "^6.2.6",
    "flag-icons": "^7.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
